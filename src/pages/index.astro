---
const redirectScript = `
  const browserLocale = navigator.language?.toLowerCase() || 'en';
  const locale = browserLocale.startsWith('pt') ? 'pt-BR' : 'en';

  window.location.replace('/' + locale + '/');
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Fernando Augusto Santos</title>
    <script is:inline set:html={redirectScript}></script>
  </head>
  <body>
    <main>
      <h1>Fernando Augusto Santos</h1>
      <p>Select your language:</p>

      <nav aria-label="Language selection">
        <a href="/en/" lang="en">English</a>
        <a href="/pt-BR/" lang="pt-BR">Português (Brasil)</a>
      </nav>
    </main>
  </body>
</html>