---
import Layout from '../layouts/Layout.astro';
import { translations } from '../content/translations';

const content = translations.en;
const jsonTranslations = JSON.stringify(translations);
---
<Layout title={content.site.title} description={content.site.description} locale={content.htmlLang} nav={content.nav} footer={content.footer} translations={jsonTranslations}>
  <section class="hero" id="home" data-section="home">
    <div class="hero-top">
      <span data-i18n="hero.role">{content.hero.role}</span>
      <span data-i18n="hero.location">{content.hero.location}</span>
      <button class="language-toggle" type="button" data-locale-toggle aria-pressed="false" aria-label="Switch language">{content.hero.language}</button>
    </div>
    <div class="hero-main">
      <div class="hero-name">
        <span data-i18n="hero.firstName">{content.hero.firstName}</span>
        <span data-i18n="hero.middleName">{content.hero.middleName}</span>
        <span class="accent" data-i18n="hero.lastName">{content.hero.lastName}</span>
      </div>
      <img class="hero-portrait" src="/profile.png" alt={content.hero.portraitAlt} data-i18n-attr="alt:hero.portraitAlt" loading="eager" />
    </div>
    <div class="hero-bottom">
      <p data-i18n="hero.description">{content.hero.description}</p>
      <div class="hero-links">
        <a href="https://www.linkedin.com/in/fstrony/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a href="https://github.com/FStrony" target="_blank" rel="noreferrer">GitHub ↗</a>
         <a href={content.resume.url} target="_blank" rel="noopener noreferrer" data-i18n="resume.label" data-i18n-attr="href:resume.url">{content.resume.label}</a>
        <a href="#work" data-i18n="hero.selectedWork">{content.hero.selectedWork}</a>
      </div>
    </div>
  </section>

  <section class="manifesto" id="about">
    <div class="side-label"><span>01 / </span><span data-i18n="sections.profile">{content.sections.profile}</span></div>
    <div>
      <p class="statement"><span data-i18n="profile.statementBefore">{content.profile.statementBefore}</span><em data-i18n="profile.statementEmphasis">{content.profile.statementEmphasis}</em><span data-i18n="profile.statementAfter">{content.profile.statementAfter}</span></p>
      <div class="manifesto-grid">
        <p data-i18n="profile.body1">{content.profile.body1}</p>
        <p data-i18n="profile.body2">{content.profile.body2}</p>
      </div>
    </div>
  </section>

  <section class="numbers">
    {content.numbers.map((item, i) => <div><strong>{item.value}</strong><span data-i18n={`numbers.${i}.label`}>{item.label}</span></div>)}
  </section>

  <section class="section" id="engineering">
    <div class="side-label"><span>02 / </span><span data-i18n="sections.engineering">{content.sections.engineering}</span></div>
    <div>
      <p class="kicker" data-i18n="engineering.kicker">{content.engineering.kicker}</p>
      <h2 class="section-title"><span data-i18n="engineering.titleBefore">{content.engineering.titleBefore}</span><br /><span data-i18n="engineering.titleAfter">{content.engineering.titleAfter}</span></h2>
      <div class="stack-list">
        {content.engineering.stack.map(([title, items], i) => <div class="stack-row"><span class="meta">0{i + 1}</span><h3 data-i18n={`engineering.stack.${i}.title`}>{title}</h3><div class="stack-items">{items.map((item, j) => <span class="tag" data-i18n={`engineering.stack.${i}.items.${j}`}>{item}</span>)}</div></div>)}
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="side-label"><span>03 / </span><span data-i18n="sections.experience">{content.sections.experience}</span></div>
    <div>
      <p class="kicker" data-i18n="experience.kicker">{content.experience.kicker}</p>
      <h2 class="section-title"><span data-i18n="experience.titleBefore">{content.experience.titleBefore}</span><br /><span data-i18n="experience.titleAfter">{content.experience.titleAfter}</span></h2>
      <div class="timeline">
        {content.experience.items.map((item, i) => <article>
          <time class="meta" datetime={item.start} data-i18n={`experience.items.${i}.period`}>{item.period}</time>
          <div>
            <h3 data-i18n={`experience.items.${i}.role`}>{item.role}</h3>
            <p class="company" data-i18n={`experience.items.${i}.company`}>{item.company}</p>
            <p data-i18n={`experience.items.${i}.description`}>{item.description}</p>
          </div>
          <span class="role meta" data-i18n={`experience.items.${i}.tags`}>{item.tags}</span>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="side-label"><span>04 / </span><span data-i18n="sections.work">{content.sections.work}</span></div>
    <div>
      <p class="kicker" data-i18n="work.kicker">{content.work.kicker}</p>
      <h2 class="section-title"><span data-i18n="work.titleBefore">{content.work.titleBefore}</span><br /><span data-i18n="work.titleAfter">{content.work.titleAfter}</span></h2>
      {content.work.projects.map((project, i) => <article class="case">
        <div class="case-top"><span class="case-no">{project.no}</span><span class="eyebrow" data-i18n={`work.projects.${i}.label`}>{project.label}</span></div>
        <div class="case-main">
          <div>
            <h3 data-i18n={`work.projects.${i}.title`}>{project.title}</h3>
            <p class="case-intro" data-i18n={`work.projects.${i}.intro`}>{project.intro}</p>
            <div class="tags">{project.tags.map((tag, j) => <span class="tag" data-i18n={`work.projects.${i}.tags.${j}`}>{tag}</span>)}</div>
          </div>
          <div class="case-details">
            <div><small data-i18n="work.labels.problem">{content.work.labels.problem}</small><p data-i18n={`work.projects.${i}.problem`}>{project.problem}</p></div>
            <div><small data-i18n="work.labels.approach">{content.work.labels.approach}</small><p data-i18n={`work.projects.${i}.approach`}>{project.approach}</p></div>
            <div><small data-i18n="work.labels.role">{content.work.labels.role}</small><p data-i18n={`work.projects.${i}.role`}>{project.role}</p></div>
          </div>
        </div>
      </article>)}
      <p class="confidential" data-i18n="work.confidential">{content.work.confidential}</p>
    </div>
  </section>

  <section class="section international">
    <div class="side-label"><span>05 / </span><span data-i18n="sections.international">{content.sections.international}</span></div>
    <div>
      <div class="country"><span data-i18n="international.country">{content.international.country}</span><span data-i18n-html="international.countryAfter" set:html={content.international.countryAfter}></span></div>
      <p class="large-copy" data-i18n="international.copy">{content.international.copy}</p>
      <div class="language-line"><span data-i18n="international.language">{content.international.language}</span><strong data-i18n="international.band">{content.international.band}</strong><span data-i18n="international.switch">{content.international.switch}</span></div>
    </div>
  </section>

  <section class="section">
    <div class="side-label"><span>06 / </span><span data-i18n="sections.education">{content.sections.education}</span></div>
    <div>
      <p class="kicker" data-i18n="education.kicker">{content.education.kicker}</p>
      <h2 class="section-title"><span data-i18n="education.titleBefore">{content.education.titleBefore}</span><br /><span data-i18n="education.titleAfter">{content.education.titleAfter}</span></h2>
      <div class="education-list">
        {content.education.items.map((item, i) => <article><span class="meta" data-i18n={`education.items.${i}.period`}>{item.period}</span><h3 data-i18n={`education.items.${i}.degree`}>{item.degree}</h3><p data-i18n={`education.items.${i}.institution`}>{item.institution}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section beyond">
    <div class="side-label"><span>07 / </span><span data-i18n="sections.beyond">{content.sections.beyond}</span></div>
    <div>
      <p class="kicker" data-i18n="beyond.kicker">{content.beyond.kicker}</p>
      <h2><span data-i18n="beyond.titleBefore">{content.beyond.titleBefore}</span><br /><span data-i18n="beyond.titleAfter">{content.beyond.titleAfter}</span></h2>
      <p data-i18n="beyond.body">{content.beyond.body}</p>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="side-label"><span>08 / </span><span data-i18n="sections.contact">{content.sections.contact}</span></div>
    <div>
      <p class="kicker" data-i18n="contact.kicker">{content.contact.kicker}</p>
      <h2><span data-i18n="contact.titleBefore">{content.contact.titleBefore}</span><br /><span data-i18n="contact.titleAfter">{content.contact.titleAfter}</span></h2>
      <p data-i18n="contact.body">{content.contact.body}</p>
      <div class="contact-links">
        <a href="mailto:fstrony@gmail.com" data-i18n="contact.links.email">{content.contact.links.email}</a>
        <a href="tel:+5511972625933" data-i18n="contact.links.phone">{content.contact.links.phone}</a>
        <a href="https://www.linkedin.com/in/fstrony/" target="_blank" rel="noreferrer" data-i18n="contact.links.linkedin">{content.contact.links.linkedin}</a>
        <a href="https://github.com/FStrony" target="_blank" rel="noreferrer" data-i18n="contact.links.github">{content.contact.links.github}</a>
        <a href={content.resume.url} target="_blank" rel="noopener noreferrer" data-i18n="resume.label" data-i18n-attr="href:resume.url">{content.resume.label}</a>
      </div>
    </div>
  </section>
</Layout>

