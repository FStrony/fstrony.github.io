---
const redirectScript = `
  const browserLocale = navigator.language?.toLowerCase() || 'en';

  const locale = browserLocale.startsWith('pt')
    ? 'pt-BR'
    : 'en';

  window.location.replace('/' + locale + '/');
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="5;url=/en/" />
    <title>Fernando Augusto Santos</title>
    <script is:inline set:html={redirectScript}></script>
  </head>
  <body>
    <p>Redirecting…</p>
  </body>
</html>