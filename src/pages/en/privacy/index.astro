---
import Layout from '../../../layouts/Layout.astro';
import PrivacyNotice from '../../../components/PrivacyNotice.astro';
import { translations } from '../../../content/translations';

const content = translations.en;
---

<Layout
  title={`${content.privacy.title} | Fernando Augusto Santos`}
  description="Privacy notice for analytics used by the Fernando Augusto Santos portfolio."
  locale={content.htmlLang}
  nav={content.nav}
  footer={content.footer}
>
  <PrivacyNotice content={content} />
</Layout>
