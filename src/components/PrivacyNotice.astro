---
const { content } = Astro.props;
const privacy = content.privacy;
const isPortuguese = content.locale === 'pt-BR';
const alternateUrl = isPortuguese ? '/en/privacy/' : '/pt-BR/privacy/';
---

<div class="privacy-page">
  <div class="privacy-topline">
    <a class="back-link" href={content.locale === 'pt-BR' ? '/pt-BR/' : '/en/'}>{privacy.back}</a>
    <a class="privacy-language" href={alternateUrl} aria-label={privacy.languageAriaLabel}>{privacy.language}</a>
  </div>

  <header>
    <p class="kicker">{privacy.kicker}</p>
    <h1>{privacy.title}</h1>
    <p class="updated">{privacy.updated}</p>
  </header>

  <section>
    <h2>{privacy.controllerTitle}</h2>
    <p>{privacy.controller} <a href="mailto:fstrony@gmail.com">fstrony@gmail.com</a>.</p>
  </section>

  <section>
    <h2>{privacy.collectedTitle}</h2>
    <p>{privacy.collectedIntro}</p>
    <p>{privacy.collectedLead}</p>
    <ul>
      {privacy.collectedItems.map((item) => <li>{item}</li>)}
    </ul>
    <p>{privacy.noPii}</p>
  </section>

  <section>
    <h2>{privacy.measuresTitle}</h2>
    <ul>
      {privacy.measures.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2>{privacy.thirdPartyTitle}</h2>
    <p>{privacy.thirdParty}</p>
    <p><a href="https://umami.is/" target="_blank" rel="noreferrer">{privacy.umami}</a> · <a href="https://docs.umami.is/docs/faq" target="_blank" rel="noreferrer">{privacy.faq}</a></p>
  </section>

  <section>
    <h2>{privacy.rightsTitle}</h2>
    <p>{privacy.rights} <a href="mailto:fstrony@gmail.com">fstrony@gmail.com</a>.</p>
  </section>

  <section>
    <h2>{privacy.contactTitle}</h2>
    <p>{privacy.contact} <a href="mailto:fstrony@gmail.com">fstrony@gmail.com</a>.</p>
  </section>
</div>

<style>
.privacy-page{width:min(820px,calc(100% - 64px));margin:0 auto;padding:90px 0 130px}.privacy-topline{display:flex;align-items:center;justify-content:space-between}.back-link,.privacy-language{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.privacy-language{border:1px solid #c8c4ba;padding:6px 9px}.privacy-language:hover{color:var(--accent);border-color:var(--accent);text-decoration:none}.privacy-page header{border-top:1px solid var(--line);margin-top:28px;padding-top:28px}.privacy-page h1{font-family:'Space Grotesk';font-size:clamp(58px,9vw,100px);line-height:.9;letter-spacing:-.07em;font-weight:500;margin:18px 0}.kicker,.updated{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.privacy-page section{border-top:1px solid var(--line);padding:38px 0}.privacy-page h2{font-family:'Space Grotesk';font-size:28px;letter-spacing:-.03em;margin:0 0 18px}.privacy-page p,.privacy-page li{color:#525752;font-size:15px;line-height:1.7}.privacy-page ul{padding-left:22px}.privacy-page code{font-size:.9em}.privacy-page a{text-decoration:underline;text-underline-offset:4px}.privacy-page .privacy-language{text-decoration:none}@media(max-width:820px){.privacy-page{width:calc(100% - 40px);padding:60px 0 90px}.privacy-page h1{font-size:18vw}.privacy-page section{padding:30px 0}}
</style>
