---
import { getRelativeLocaleUrl } from 'astro:i18n';

const { content } = Astro.props;

const currentLocale = content.locale;
const alternateLocale = currentLocale === 'pt-BR' ? 'en' : 'pt-BR';
const alternateUrl = getRelativeLocaleUrl(alternateLocale, '', {
  normalizeLocale: false,
});
---

<section class="hero" id="home" data-section="home">
    <div class="hero-top">
        <span>{content.hero.role}</span>
        <span>{content.hero.location}</span>
        <a class="language-toggle" href={alternateUrl} aria-label={content.hero.languageAriaLabel}>
            {content.hero.language}
        </a>
    </div>
    <div class="hero-main">
        <h1 class="hero-name">
            <span>{content.hero.firstName}</span>
            <span>{content.hero.middleName}</span>
            <span class="accent">{content.hero.lastName}</span>
        </h1>
        <img class="hero-portrait" src="/profile.png" alt={content.hero.portraitAlt} loading="eager" />
    </div>
    <div class="hero-bottom">
        <p>{content.hero.description}</p>
        <div class="hero-links">
            <a href="https://www.linkedin.com/in/fstrony/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
            <a href="https://github.com/FStrony" target="_blank" rel="noreferrer">GitHub ↗</a>
            <a href={content.resume.url} target="_blank" rel="noopener noreferrer">{content.resume.label}</a>
            <a href="#work">{content.hero.selectedWork}</a>
        </div>
    </div>
</section>

<section class="manifesto" id="about">
    <div class="side-label"><span>01 / </span><span>{content.sections.profile}</span></div>
    <div>
        <p class="statement">
            <span>{content.profile.statementBefore}</span><em>{content.profile.statementEmphasis}</em><span>{content.profile.statementAfter}</span>
        </p>
        <div class="manifesto-grid">
            <p>{content.profile.body1}</p>
            <p>{content.profile.body2}</p>
        </div>
    </div>
</section>

<section class="numbers">
    {content.numbers.map((item, i) => <div><strong>{item.value}</strong><span
            data-i18n={`numbers.${i}.label`}>{item.label}</span></div>)}
</section>

<section class="section" id="engineering">
    <div class="side-label"><span>02 / </span><span>{content.sections.engineering}</span></div>
    <div>
        <p class="kicker">{content.engineering.kicker}</p>
        <h2 class="section-title">
            <span>{content.engineering.titleBefore}</span><br /><span>{content.engineering.titleAfter}</span></h2>
        <div class="stack-list">
            {content.engineering.stack.map(([title, items], i) => <div class="stack-row"><span class="meta">0{i +
                    1}</span>
                <h3 data-i18n={`engineering.stack.${i}.title`}>{title}</h3>
                <div class="stack-items">{items.map((item, j) => <span class="tag"
                        data-i18n={`engineering.stack.${i}.items.${j}`}>{item}</span>)}</div>
            </div>)}
        </div>
    </div>
</section>

<section class="section" id="experience">
    <div class="side-label"><span>03 / </span><span>{content.sections.experience}</span>
    </div>
    <div>
        <p class="kicker">{content.experience.kicker}</p>
        <h2 class="section-title">
            <span>{content.experience.titleBefore}</span><br /><span>{content.experience.titleAfter}</span></h2>
        <div class="timeline">
            {content.experience.items.map((item, i) => <article>
                <time class="meta" datetime={item.start} data-i18n={`experience.items.${i}.period`}>{item.period}</time>
                <div>
                    <h3 data-i18n={`experience.items.${i}.role`}>{item.role}</h3>
                    <p class="company" data-i18n={`experience.items.${i}.company`}>{item.company}</p>
                    <p data-i18n={`experience.items.${i}.description`}>{item.description}</p>
                </div>
                <span class="role meta" data-i18n={`experience.items.${i}.tags`}>{item.tags}</span>
            </article>)}
        </div>
    </div>
</section>

<section class="section" id="work">
    <div class="side-label"><span>04 / </span><span>{content.sections.work}</span></div>
    <div>
        <p class="kicker">{content.work.kicker}</p>
        <h2 class="section-title"><span>{content.work.titleBefore}</span><br /><span>{content.work.titleAfter}</span>
        </h2>
        {content.work.projects.map((project, i) => <article class="case">
            <div class="case-top"><span class="case-no">{project.no}</span><span class="eyebrow"
                    data-i18n={`work.projects.${i}.label`}>{project.label}</span></div>
            <div class="case-main">
                <div>
                    <h3 data-i18n={`work.projects.${i}.title`}>{project.title}</h3>
                    <p class="case-intro" data-i18n={`work.projects.${i}.intro`}>{project.intro}</p>
                    <div class="tags">{project.tags.map((tag, j) => <span class="tag"
                            data-i18n={`work.projects.${i}.tags.${j}`}>{tag}</span>)}</div>
                </div>
                <div class="case-details">
                    <div><small>{content.work.labels.problem}</small>
                        <p data-i18n={`work.projects.${i}.problem`}>{project.problem}</p>
                    </div>
                    <div><small>{content.work.labels.approach}</small>
                        <p data-i18n={`work.projects.${i}.approach`}>{project.approach}</p>
                    </div>
                    <div><small>{content.work.labels.role}</small>
                        <p data-i18n={`work.projects.${i}.role`}>{project.role}</p>
                    </div>
                </div>
            </div>
        </article>)}
        <p class="confidential">{content.work.confidential}</p>
    </div>
</section>

<section class="section international">
    <div class="side-label"><span>05 / </span><span>{content.sections.international}</span></div>
    <div>
        <div class="country"><span>{content.international.country}</span><span
                set:html={content.international.countryAfter}></span></div>
        <p class="large-copy">{content.international.copy}</p>
        <div class="language-line">
            <span>{content.international.language}</span><strong>{content.international.band}</strong><span>{content.international.switch}</span>
        </div>
    </div>
</section>

<section class="section">
    <div class="side-label"><span>06 / </span><span>{content.sections.education}</span>
    </div>
    <div>
        <p class="kicker">{content.education.kicker}</p>
        <h2 class="section-title">
            <span>{content.education.titleBefore}</span><br /><span>{content.education.titleAfter}</span></h2>
        <div class="education-list">
            {content.education.items.map((item, i) => <article><span class="meta"
                    data-i18n={`education.items.${i}.period`}>{item.period}</span>
                <h3 data-i18n={`education.items.${i}.degree`}>{item.degree}</h3>
                <p data-i18n={`education.items.${i}.institution`}>{item.institution}</p>
            </article>)}
        </div>
    </div>
</section>

<section class="section beyond">
    <div class="side-label"><span>07 / </span><span>{content.sections.beyond}</span></div>
    <div>
        <p class="kicker">{content.beyond.kicker}</p>
        <h2><span>{content.beyond.titleBefore}</span><br /><span>{content.beyond.titleAfter}</span></h2>
        <p>{content.beyond.body}</p>
    </div>
</section>

<section class="contact" id="contact">
    <div class="side-label"><span>08 / </span><span>{content.sections.contact}</span></div>
    <div>
        <p class="kicker">{content.contact.kicker}</p>
        <h2><span>{content.contact.titleBefore}</span><br /><span>{content.contact.titleAfter}</span></h2>
        <p>{content.contact.body}</p>
        <div class="contact-links">
            <a href="mailto:fstrony@gmail.com">{content.contact.links.email}</a>
            <a href="tel:+5511972625933">{content.contact.links.phone}</a>
            <a href="https://www.linkedin.com/in/fstrony/" target="_blank"
                rel="noreferrer">{content.contact.links.linkedin}</a>
            <a href="https://github.com/FStrony" target="_blank" rel="noreferrer">{content.contact.links.github}</a>
            <a href={content.resume.url} target="_blank" rel="noopener noreferrer">{content.resume.label}</a>
        </div>
    </div>
</section>